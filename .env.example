# Configuration for running against Supabase (docs/SETUP.md). Copy to
# .env.local for `pnpm dev`; set the same keys in Vercel for deployments.
# Local-only work (`pnpm dev:local`, tests) needs none of this.

GAMEBASE_BACKEND=supabase

# The app's own least-privilege role (gamebase_app) through the Supavisor
# pooler in transaction mode (port 6543). Never the postgres role.
DATABASE_URL=postgres://gamebase_app.<project-ref>:<password>@<pooler-host>:6543/postgres

# The public address of the site, e.g. https://gamebase.vercel.app
NEXT_PUBLIC_SITE_URL=

# Supabase → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: bans and deletes accounts. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile site key for the email sign-in form (optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sign-in buttons to show (default: all three)
SIGNIN_METHODS=discord,google,email

# 32+ random characters (openssl rand -hex 32); Vercel sends it to the cron.
CRON_SECRET=

# Only on your own machine, for `pnpm db:migrate` and `pnpm make-owner`:
# the postgres (owner) role on the session pooler or direct connection (5432).
# Never set this on Vercel.
MIGRATION_DATABASE_URL=
